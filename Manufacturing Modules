<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects | Chelsea Ogbonna</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #edf2fb;
      --card: #d7e3fc;
      --accent: #abc4ff;
      --text: #1f2937;
      --border: #c1d3fe;
      --card-hover: #ccdbfd;
      --shadow: 0 12px 30px rgba(0, 0, 0, .08);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* =========================
    NAVBAR
    ========================= */
    nav {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1100px, 92%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
    }

    .logo {
      font-weight: 800;
      font-size: 18px;
      text-decoration: none;
      color: var(--text);
    }

    .nav-links {
      display: flex;
      gap: 10px;
      padding: 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .78);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(193, 211, 254, .45);
      box-shadow: 0 12px 35px rgba(0, 0, 0, .10);
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text);
      padding: 10px 14px;
      border-radius: 10px;
      transition: .25s;
      font-weight: 500;
    }

    .nav-links a.active, .nav-links a:hover {
      background: var(--accent);
      transform: translateY(-2px);
    }

    /* =========================
    LAYOUT WRAPPER
    ========================= */
    .content {
      width: min(1200px, 90%);
      margin: auto;
      padding: 140px 0 100px;
    }

    /* HERO / HEADER */
    .hero {
      text-align: center;
      margin-bottom: 60px;
    }

    .hero h1 {
      font-size: 60px;
      font-weight: 800;
      margin-bottom: 20px;
    }

    .hero p {
      max-width: 750px;
      margin: auto;
      color: #4b5563;
      font-size: 18px;
      line-height: 1.8;
    }

    /* Quick Jump Filter Bar */
    .quick-nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 60px;
    }

    .quick-nav a {
      text-decoration: none;
      color: var(--text);
      background: rgba(255, 255, 255, 0.7);
      padding: 8px 18px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      border: 1px solid rgba(193, 211, 254, 0.6);
      transition: all 0.25s ease;
    }

    .quick-nav a:hover {
      background: var(--accent);
      transform: translateY(-2px);
    }

    /* =========================
    PROJECT CARD ARCHITECTURE
    ========================= */
    .section {
      margin: 40px 0;
      scroll-margin-top: 110px;
    }

    .project-card {
      background: var(--card);
      border-radius: 20px;
      padding: 40px;
      box-shadow: var(--shadow);
      transition: .3s;
      margin-bottom: 50px;
    }

    .project-card:hover {
      background: var(--card-hover);
      transform: translateY(-4px);
    }

    .project-card h2 {
      font-size: 28px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }

    .project-card h3 {
      font-size: 16px;
      font-weight: 600;
      color: #6C8EF5;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 30px;
    }

    .project-card h4 {
      font-size: 15px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
      color: var(--text);
    }

    .project-card p {
      color: #4b5563;
      font-size: 15px;
      line-height: 1.7;
    }

    /* Balanced Asymmetric Layout */
    .card-layout-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: start;
    }

    .text-column-left {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .media-column-right {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .info-block {
      background: rgba(255, 255, 255, 0.45);
      padding: 25px;
      border-radius: 14px;
      border: 1px solid rgba(193, 211, 254, 0.55);
    }

    /* Smooth Hover-Zoom Image Frame */
    .img-frame {
      width: 100%;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(0, 0, 0, .05);
      border: 1px solid rgba(255,255,255,0.5);
      aspect-ratio: 4/3;
      background: rgba(255, 255, 255, 0.6);
    }

    .img-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      cursor: zoom-in;
      transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .img-frame:hover img {
      transform: scale(1.12);
    }

    /* LIST ELEMENTS */
    ul {
      list-style: none;
    }

    li {
      position: relative;
      padding-left: 20px;
      margin-bottom: 10px;
      font-size: 14px;
      color: #4b5563;
      line-height: 1.6;
    }

    li:last-child {
      margin-bottom: 0;
    }

    li::before {
      content: "▪";
      position: absolute;
      left: 4px;
      color: #6C8EF5;
      font-size: 14px;
      top: -1px;
    }

    /* SKILLS PILLS */
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-top: 5px;
    }

    .tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.65);
      color: var(--text);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      border: 1px solid rgba(193, 211, 254, 0.5);
    }

    .project-card:hover .tag {
      background: rgba(255, 255, 255, 0.9);
      border-color: var(--accent);
    }

    /* =========================
    NEXT PAGE CALL TO ACTION
    ========================= */
    .next-page-container {
      text-align: center;
      margin: 80px 0 20px 0;
      padding: 20px;
    }

    .next-page-container p {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #6b7280;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .next-page-btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--card);
      color: var(--text);
      text-decoration: none;
      padding: 18px 36px;
      border-radius: 999px;
      font-size: 18px;
      font-weight: 700;
      box-shadow: var(--shadow);
      border: 1px solid rgba(193, 211, 254, 0.6);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .next-page-btn .arrow {
      transition: transform 0.3s ease;
    }

    .next-page-btn:hover {
      background: var(--accent);
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(171, 196, 255, 0.4);
    }

    .next-page-btn:hover .arrow {
      transform: translateX(6px);
    }

    /* ANIMATION UTILITIES */
    .hidden {
      opacity: 0;
      transform: translateY(30px);
      transition: all .6s ease-out;
    }

    .show {
      opacity: 1;
      transform: translateY(0);
    }

    /* RESPONSIVE DESIGN ADJUSTMENTS */
    @media (max-width: 900px) {
      .card-layout-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }
      .media-column-right {
        order: -1;
      }
      .img-frame {
        aspect-ratio: 16/10;
      }
      body { padding: 40px 4%; }
      .hero h1 { font-size: 40px; }
    }
  </style>
</head>

